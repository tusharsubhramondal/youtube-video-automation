{
  "name": "youtube-automation-backend",
  "version": "1.0.0",
  "description": "Backend API & Orchestration Engine for AI YouTube Video Automation",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && prisma generate",
    "start": "node dist/server.js",
