# Server & Application Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database & Cache (PostgreSQL & Redis)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/youtube_automation?schema=public
REDIS_URL=redis://localhost:6379

# AI Providers (Leave empty to use built-in Mock / Free providers)
GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Google OAuth & YouTube Data API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/youtube/oauth2callback

# Storage & Uploads
UPLOAD_DIR=./uploads
RENDER_DIR=./renders

# Security
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars

